
<%- include('menu.ejs') %>
    <style>
        body {
            background-color: #f1f1f1;
            /* font-family: 'Tahoma', sans-serif; */
            direction: rtl;
            text-align: right;
            font-family: 'dana';
        }
        .container {
            max-width: 400px;
            margin-top: 0px;
            padding: 20px;
        }
        .card {
            border-radius: 15px;
            box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.1);
            background-color: #ffffff;
            padding: 20px;
            display: flex;
            /* align-items: center; */
        }
        .profile-pic {
            width: 120px;
            height: 120px;
            border-radius: 10px;
            border: 3px solid #027300;
            object-fit: cover;
            margin-right: 90px; /* فاصله بین عکس و متن */
            margin-left: 0;
        }
        .info-container {
            flex: 1;
            margin-top: 10px;
        }
        .info {
            width: 300px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(0, 0, 0, 0.192);
            justify-content: space-between;
            /* margin-bottom: 10px; */
            font-size: 16px;
            margin-bottom: 15px;
            padding: 0px 10px;
            
        }
        .info strong {
            color: #008423;
            min-width: 120px;
        }
        .info span {
            color: #333;
            /* font-weight: bold; */
        }
    </style>
</head>
<body>

   <% result.forEach(element => { %>
    
  
    <div class="container">
        <!-- کارت اطلاعات شاگرد -->
        <div class="card">
            <img src="<%= element.photo_student  %>" alt="تصویر شاگرد" class="profile-pic">
            <div class="info-container">
                <div class="info">
                    <strong>آیدی:</strong>
                    <span><%= element.id_number  %></span>
                </div>
                <div class="info">
                    <strong>نام:</strong>
                    <span><%= element.name_student  %></span>
                </div>
                <div class="info">
                    <strong>نام خانوادگی:</strong>
                    <span><%= element.LastName_student  %></span>
                </div>
                <div class="info">
                    <strong>شماره تماس:</strong>
                    <span><%= element.number_student  %></span>
                </div>
               
                <div class="info">
                    <strong>رشته تحصیلی:</strong>
                    <span> <%= element.subject  %></span>
                </div>
                <div class="info">
                    <strong> صنف شاگرد:</strong>
                    <span> <%= element.class_student  %></span>
                </div>
                <div class="info">
                    <strong> استاد شاگرد:</strong>
                    <span> <%= element.teacher_name  %></span>
                </div>
                <div class="info">
                    <strong> تایم شاگرد:</strong>
                    <span> <%= element.time_student  %></span>
                </div>
                <div class="info">
                    <strong>فیس:</strong>
                    <span><%= element.all_money  %></span>
                </div>
                <div class="info">
                    <strong>مقدار پرداخت شده:</strong>
                    <span><%= element.payment_money  %></span>
                </div>
                <div class="info">
                    <strong>مقدار باقی‌مانده:</strong>
                    <span><%= element.remaining_money  %></span>
                </div>
            </div>
            <a href="/searchStudent"><button style="position: absolute; top: -20px ; right: -20px; font-size: 30px; color: red; border: none; background: transparent;">&Cross;</button></a>
        </div>
    </div>
    <% }); %>

</body>
</html>
