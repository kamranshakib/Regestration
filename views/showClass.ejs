 

<style>
    .table tr:nth-child(even){
     background-color: rgba(181, 180, 180, 0.193);
    
     
    
      }
      .table tr:nth-child(even):hover{
         color: rgb(2, 150, 9);
     
      }
 </style>
 
 <div class="container" style="z-index: 5;background-color: rgba(240, 248, 255, 0.249); backdrop-filter: blur(2px); width: 800px;">
     
 <table  class="table table-hover" >
     <thead>
         <tr style="color: rgb(0, 0, 0);">
             <th>صنف</th>
             <th>استاد</th>
             <th>فیس</th>
             <th>وضعیت</th>
             <th>تایم</th>
             <th>  مشخصات</th>
         </tr>
     </thead>
     <tbody>
       
        <% result.forEach(element => { %>
            
             <tr style="padding: 10px;">
                    <td><%= element.nameOfClass %></td>
                    <td><%= element.teacherNameOfClass %></td>
                    <td><%= element.moneyOfeveryStClass %></td>
                    <td>فعال</td>
                    <td><%=element.TimeOfClass%></td>
                    <td><button style="border: none; background-color: green; color: white; padding: 5px 10px; border-radius: 5px;" type="submit"> <a href="showInformationOfClass/<%= element._id%>" style="text-decoration: none; color: rgb(255, 255, 255);">مشخصات بیشتر</a></button></td>     
                    <td><a href=""><i class="fa fa-edit" style="color: green;"></i></a> 
                    <a id="delete"  href="/deleteClass/<%= element._id %>"><i style="transform: translateX(-10px); color: rgb(181, 0, 0);" class="fa fa-trash-can"></i></a>
                </td>              
                </tr>
            
            <%  }); %>
               
             
                
                
         </tbody>
     </table>
   
 </div>
    
 

<script>
    const showDelete = document.getElementById('divDelete')
    const Delete = document.getElementById('delete')
    Delete.addEventListener('click',()=>{
         alert('صنف حذف شود؟')
    })
</script>
<body>
















