<%- include('searchClass.ejs') %>

<style>
    .table tr:nth-child(even){
     background-color: rgba(181, 180, 180, 0.193);
    
     
    
      }
      .table tr:nth-child(even):hover{
         color: rgb(2, 150, 9);
     
      }
 </style>
 
 <div class="container" style="z-index: 5;background-color: rgba(240, 248, 255, 0.249); backdrop-filter: blur(2px);">
     
 <table  class="table table-hover" >
     <thead>
         <tr style="color: rgb(0, 0, 0);">
             <th>صنف</th>
             <th>استاد</th>
             <th>فیس</th>
             <th>وضعیت</th>
             <th>نتایج بیشتر</th>
         </tr>
     </thead>
     <tbody>
         <% result.forEach(element => { %>
             <tr >
                 <td><%= element.class_student %></td>
                 <td><%= element.teacher_name %></td>
                 <td>1000</td>
                 <td>فعال </td>
                 <td><a href="/showStudents/<%=element._id%>">مشخصات </a></td>
                
             </tr>
             <%  }); %>
             
         </tbody>
     </table>
 </div>
    
 


