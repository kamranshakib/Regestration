<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نمایش صنف‌ها</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        body {
            background-color: #f1f4f8;
            /* font-family: Arial, sans-serif; */
            font-family: 'dana';
        }
        .container {
            max-width: 900px;
            background-color: #ffffff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 10px 20px rgba(0, 0, 0, 0.1);
            margin-top: 50px;
            transition: all 0.3s ease-in;
        }
        h2 {
            color: #000000;
            text-align: center;
            margin-bottom: 30px;
        }
        .class-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            background-color: #17a900;
            color: white;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .class-header:hover {
            background-color: #f7f7f757;
            color: #000000;
        }
        .class-details {
            padding: 15px;
            background-color: #f9f9f9;
            border-radius: 8px;
            
        }
        .class-details p {
            margin: 5px 0;
            color: #777;
        }
        .class-details .icons {
            display: flex;
            justify-content: flex-start;
            gap: 10px;
        }
        
       
       
    </style>
</head>
<body>

<div class="container">
    <h2>صنف‌ها</h2>

    <!-- Accordion -->
    <div class="accordion" id="classAccordion">
        
        <!-- Class 1 -->
        <div class="accordion-item">
            <div class="class-header" id="classHeadingOne" data-bs-toggle="collapse" data-bs-target="#classCollapseOne" aria-expanded="true" aria-controls="classCollapseOne">
                <span><i class="fas fa-chalkboard-teacher"></i> صنف فیزیک</span>
                <span>فیس: 1500 افغانی | وضعیت: فعال</span>
            </div>
            <div id="classCollapseOne" class="accordion-collapse collapse" aria-labelledby="classHeadingOne" data-bs-parent="#classAccordion">
                <div class="class-details">
                    <p>تعداد شاگردان: 25</p>
                    <p>سهم استاد: 900 افغانی</p>
                    <p>زمان برگزاری: دوشنبه‌ها ساعت 10 صبح</p>
                    <div class="icons">
                        <i class="fas fa-users"></i> <span>25 شاگرد</span>
                        <i class="fas fa-check-circle"></i> <span>فعال</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Class 2 -->
        <div class="accordion-item">
            <div class="class-header" id="classHeadingTwo" data-bs-toggle="collapse" data-bs-target="#classCollapseTwo" aria-expanded="false" aria-controls="classCollapseTwo">
                <span><i class="fas fa-chalkboard-teacher"></i> صنف ریاضی</span>
                <span>فیس: 1300 افغانی | وضعیت: فعال</span>
            </div>
            <div id="classCollapseTwo" class="accordion-collapse collapse" aria-labelledby="classHeadingTwo" data-bs-parent="#classAccordion">
                <div class="class-details">
                    <p>تعداد شاگردان: 30</p>
                    <p>سهم استاد: 780 افغانی</p>
                    <p>زمان برگزاری: سه‌شنبه‌ها ساعت 11 صبح</p>
                    <div class="icons">
                        <i class="fas fa-users"></i> <span>30 شاگرد</span>
                        <i class="fas fa-check-circle"></i> <span>فعال</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Class 3 -->
        <div class="accordion-item">
            <div class="class-header" id="classHeadingThree" data-bs-toggle="collapse" data-bs-target="#classCollapseThree" aria-expanded="false" aria-controls="classCollapseThree">
                <span><i class="fas fa-chalkboard-teacher"></i> صنف شیمی</span>
                <span>فیس: 1400 افغانی | وضعیت: غیر فعال</span>
            </div>
            <div id="classCollapseThree" class="accordion-collapse collapse" aria-labelledby="classHeadingThree" data-bs-parent="#classAccordion">
                <div class="class-details">
                    <p>تعداد شاگردان: 15</p>
                    <p>سهم استاد: 840 افغانی</p>
                    <p>زمان برگزاری: پنج‌شنبه‌ها ساعت 2 بعد از ظهر</p>
                    <div class="icons">
                        <i class="fas fa-users"></i> <span>15 شاگرد</span>
                        <i class="fas fa-times-circle"></i> <span>غیر فعال</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <!-- End Accordion -->

</div>

<!-- Bootstrap Bundle with Popper (for accordion functionality) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
