<!DOCTYPE html>
<html lang="en" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <%- include('header.ejs') %>
    <% studentInfo.forEach(element => { %>
    <div class="studentinforMation">
     
        <div class="photo-student"> 
          <img src="<%= element.photo_student %>" alt="" />
        </div>
        <div class="info_st">
          <div class="student_info_show">
            <span>اسم : </span>
            <p><%=element.name_student%></p>
          </div>
          <div class="student_info_show">
            <span>اسم پدر: </span>
            <p><%=element.fatherName_student%></p>
          </div>
          <div class="student_info_show">
            <span>نام خانوادگی : </span>
            <p><%=element.LastName_student%></p>
          </div>
          <div class="student_info_show">
            <span>    ایدی :</span>
            <p><%=element.id_number%></p>
          </div>
          <div class="student_info_show">
            <span>شماره تماس شاگرد :</span>
            <p><%=element.number_student%></p>
          </div>
          <div class="student_info_show">
            <span> شماره تماس ولی شاگرد :</span>
            <p><%=element. number_father%></p>
          </div>
          <div class="student_info_show">
            <span>    استاد شاگرد :</span>
            <p><%=element.teacher_name%></p>
          </div>
          <div>
            
          
             
            
            </div>
            
             
        </div>
        <div style="margin-right: 15px;">
          <div class="student_info_show">
            <span> تاریخ ثبت نام :</span>
            <p style="font-size: 17px;"><%=element.date_student%></p>
          </div>
          <div class="student_info_show">
            <span>    صنف :</span>
            <p><%=element.subject%></p>
          </div>
          <div class="student_info_show">
            <span>    تایم :</span>
            <p><%=element.time_student%></p>
          </div>
         
          <div class="student_info_show">
            <span>    فیس :</span>
            <p><%=element.all_money%></p>
          </div>
          <div class="student_info_show">
            <span>    فیس پرداخت :</span>
            <p><%=element.payment_money%></p>
          </div>
          <div class="student_info_show">
            <span>    فیس باقی مانده :</span>
            <p><%=element.all_money - element.payment_money%></p>
          </div>
          
         
        </div>
        
        </div>
       

       
     
    </div>
    <% }); %>

    <button
      style="
        position: absolute;
        left: 5px;
        top: 5px;
        padding: 4px 25px;
        background-color: rgb(0, 0, 0);
        background: transparent;
        border: none;
        border-radius: 5px;
      "
    >
      <a style="color: rgb(255, 255, 255); text-decoration: none; font-size: 30px" href="/"
        >&larrhk;</a
      >
    </button>
  </body>
</html>
