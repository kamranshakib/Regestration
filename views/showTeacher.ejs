<%- include('menu.ejs') %>





<style>
    .table tr:nth-child(even){
     background-color: rgba(181, 180, 180, 0.193);
    
     
    
      }
      .table tr:nth-child(even):hover{
         color: rgb(2, 150, 9);
     
      }
      .container {
            max-width: 900px;
            background: #ffffff5a;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
            position: relative;
            backdrop-filter: blur(5px);
            
        }
 </style>
 
 <div class="container" style="z-index: 5;background-color: rgba(240, 248, 255, 0.249); backdrop-filter: blur(2px); width: 800px;">
     
 <table  class="table table-hover" >
     <thead>
         <tr style="color: rgb(0, 0, 0);">
             <th>اسم</th>
             <th>تخلص</th>
             <th>شماره تماس</th>
             <th>نوع معاش</th>
             <th> معاش</th>
             <th>مشخصات</th>
         </tr>
     </thead>
     <tbody>
       
        <% result.forEach(element => { %>
             <tr >
                    <td><%= element.name_teacher %></td>
                    <td><%= element.LastName_teacher %></td>
                    <td><%= element.number_teacher%></td>
                    <td><%=element.subject_salary_teacher%></td>
                    <td><span><%= element.salary_fisad %> <span style="color: green; margin-right: 10px;">   <%= element.time_teacher%></span></span>
                        <span><%= element.salary_month %></span>
                        <span><%= element.salary_hour %></span></td>
                    <td><a style="border: none; background-color: green; color: white; padding: 5px 10px; border-radius: 5px; text-decoration: none;" href="/showTeacher22/<%=element._id%>"> مشخات بیشتر </a></td>
                   
                </tr>
           
            <%  }); %>
               
             
                
                
         </tbody>
     </table>
 </div>
    
 


<body>