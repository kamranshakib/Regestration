<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <%- include('header.ejs') %>
    <main class="main">
      <form class="form_student" action="/Regester_Student" method="post" enctype="multipart/form-data">
        <h1>مشخصات شاگرد</h1>
        <div class="name_lastname">
          <div class="name">
            <label for="">نام</label>
            <input required name="name_student" type="text" />
          </div>
          <div class="lastName">
            <label for="">نام پدر</label>
            <input required name="fatherName_student" type="text" />
          </div>
        </div>

        <div class="name_lastname">
          <div class="name">
            <label for="">نام خانوادگی</label>
            <input required name="LastName_student" type="text" />
          </div>
          <div class="lastName">
            <label for="">ولدیت</label>
            <input required name="granfather_student" type="text" />
          </div>
        </div>

        <div class="name_lastname">
          <div class="name">
            <label for="">شماره تماس</label>
            <input required name="number_student" type="number" />
          </div>
          <div class="lastName">
            <label for="">شماره تماس پدر</label>
            <input required name="number_father" type="number" />
          </div>
        </div>

        <div class="name_lastname">
          <div class="name">
            <label for="">نمبره تذکره</label>
            <input required name="number_pasport" type="text" />
          </div>
          <div class="lastName">
            <label for="">آیدی</label>
            <input required name="id_number" type="text" />
          </div>
        </div>

        </div>

        <div class="name_lastname">
          <div class="name">
            <label for="">آدرس</label>
            <input required name="address_student" type="text" />
          </div>
          <div class="lastName" style="display: flex; flex-direction: row; gap: 20px;">
                <div style="display: flex; flex-direction: column;">
                  <label for="">تاریخ ثبت</label>
                  <input style="width: 140px;" required name="date_student" type="date" />
                </div>
                <div style="display: flex; flex-direction: column; ">
                  <label for=""> تایم</label>
                  <input style="width: 140px;" required name="time_student" type="text" />
                </div>
               
            
          </div>
        </div>

        <div class="name_lastname">
          <div class="name">
            <label for="">عکس</label>
            <input name="photo_student" id="file_input" type="file" />
          </div>
          <div class="lastName" style="display: flex; flex-direction: row; gap: 20px;">
            <div style="display: flex; flex-direction: column;">
              <label for=""> فیس کل</label>
              <input style="width: 140px;" required name="all_money" type="text" />
            </div>
            <div style="display: flex; flex-direction: column; ">
              <label for=""> فیس پرداختی</label>
              <input style="width: 140px;" required name="payment_money" type="text" />
            </div>
           
      </div>
        </div>

        <div class="name_lastname">
          <div class="name">
            <label for="">مضمون</label> <input name="subject" type="text" />
          </div>
          <div class="lastName" style="display: flex; flex-direction: row; gap: 20px;">
            <div style="display: flex; flex-direction: column;">
              <label for="">  باقی مانده فیس</label>
              <input style="width: 140px;" required name="remaining_money" type="text" />
            </div>
            <div style="display: flex; flex-direction: column; ">
              <label for="">  تخفیف</label>
              <input style="width: 140px;" required name="matigate" type="text" />
            </div>
           
      </div>
        </div>

        <div class="name_lastname">
          <div class="name">
            <label for="">معلم</label>
            <input required name="teacher_name" type="text"/>
          </div>
        </div>

        <input id="submit_student" type="submit" value="ثبت مشخصات" />
        <div><img id="ba_omid" src="/Untitled-2-1.png" alt=""></div>
      </form>
    </main>
  </body>
</html>
