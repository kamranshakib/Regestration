<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <%- include('header.ejs') %>
    <main class="main">
      <form class="form_student" action="/Regester_teacher" method="post" enctype="multipart/form-data">
        <h1>مشخصات استاد</h1>
        <div class="name_lastname">
          <div class="name">
            <label for="">نام</label>
            <input required name="name_teacher" type="text" />
          </div>
          <div class="lastName">
            <label for="">نام پدر</label>
            <input required name="fatherName_teacher" type="text" />
          </div>
        </div>

        <div class="name_lastname">
          <div class="name">
            <label for="">نام خانوادگی</label>
            <input required name="LastName_teacher" type="text" />
          </div>
          <div class="lastName">
            <label for=""> تحصیلات</label>
            <input required name="edu_teacher" type="text" />
          </div>
        </div>

        <div class="name_lastname">
          <div class="name">
            <label for="">شماره تماس</label>
            <input required name="number_teacher" type="number" />
          </div>
          <div class="lastName">
            <label for=""> آدرس</label>
            <input required name="address_teacher" type="text" />
          </div>
        </div>

        </div>

        </div>
        <div class="name_lastname">
            <div class="name">
              <label for="">صنف</label> <input name="class_teache" type="text" />
            </div>
            <div class="lastName">
                <label for=""> مضمون</label>
                <input required name="subject_teacher" type="text" />
              </div>
           
          </div>
          <div class="name_lastname">
            <div class="name">
              <label for="">معاش</label>
              <input name="salary_teacher" id="" type="text" />
            </div>
            
          </div>
 
        <div class="name_lastname">
          <div class="name">
            <label for="">عکس</label>
            <input name="photo_teacher" id="file_input" type="file" />
          </div>
          
        </div>
        
       


        <input style="transform: translateY(-105px);" id="submit_student" type="submit" value="ثبت مشخصات" />
        <div><img id="ba_omid" src="/Untitled-2-1.png" alt=""></div>
      </form>
    </main>
  </body>
</html>
