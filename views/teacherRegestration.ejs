<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>فرم ثبت‌نام استاد</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap" rel="stylesheet">
    <!-- اضافه کردن Font Awesome برای آیکون‌ها -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        body {
            background-color: #f1f4f8;
            font-family: 'Roboto', sans-serif;
        }
        .container {
            max-width: 800px; /* کاهش عرض فرم */
            background: #ffffff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 10px 20px rgba(0, 0, 0, 0.1);
            margin-top: 40px;
            position: relative;
        }
        h2 {
            color: #000000;
            text-align: center;
            font-size: 28px; /* کاهش اندازه عنوان */
            margin-bottom: 30px;
        }
        .form-label {
            font-weight: 500;
            font-size: 14px;
            color: #333;
        }
        input, select, button {
            border-radius: 8px;
            border: 1px solid #ddd;
            padding: 10px;
            margin-top: 5px;
            width: 100%;
            font-size: 14px;
            box-sizing: border-box;
            transition: all 0.3s ease;
        }
        input:focus, select:focus, button:focus {
            border-color: #4a90e2;
            box-shadow: 0 0 5px rgba(74, 144, 226, 0.5);
        }
        .form-row {
            display: flex;
            justify-content: space-between;
            gap: 15px;
        }
        .form-row .col-3 {
            flex: 1;
        }
        .footer {
            text-align: center;
            margin-top: 30px;
        }
        .image-upload input[type="file"] {
            display: none;
        }
        .image-upload label {
            padding: 10px;
            background-color: #ffffff;
            color: rgb(0, 0, 0);
            border-radius: 8px;
            box-shadow: inset 0 0 10px rgba(12, 241, 111, 0.193);
            cursor: pointer;
        }
        .image-upload img {
            max-width: 100px;
            margin-top: 10px;
            position: absolute;
            left: 90px ;
            bottom: 100px; 
        }
        .input-group .input-group-text {
            background-color: #008216;
            color: white;
            width: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .input-group .form-control {
            padding-left: 10px;
            /* border-radius: 8px; */
            /* background-color: red; */
        }
    </style>
</head>
<body class="p-4">

    <div class="container">
        <h2>فرم ثبت‌نام استاد</h2>
        <form>
            <div class="row">
                <!-- ستون اول -->
                <div class="col-md-4">
                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="fas fa-user"></i></span>
                        <input type="text" class="form-control" placeholder="نام" required>
                    </div>

                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="fas fa-user-alt"></i></span>
                        <input type="text" class="form-control" placeholder="نام پدر" required>
                       
                    </div>

                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="fas fa-user-alt"></i></span>
                        <input type="text" class="form-control" placeholder="نام خانوادگی" required>
                       
                       
                    </div>

                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                        <input type="email" class="form-control" placeholder="ایمیل" required>
                       
                      
                    </div>

                </div>

                <!-- ستون دوم -->
                <div class="col-md-4">
                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="fas fa-phone"></i></span>
                        <input type="text" class="form-control" placeholder="شماره تماس" required>
                    </div>

                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                        <input type="password" class="form-control" placeholder=" نمبره تذکره" required>
                    </div>

                   
                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="fas fa-book-open"></i></span>
                        <input type="text" class="form-control" placeholder="رشته تحصیلی" required>
                    </div>

                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="fas fa-graduation-cap"></i></span>
                        <input type="text" class="form-control" placeholder="مقطع تحصیلی" required>
                    </div>
                </div>

                <!-- ستون سوم -->
                <div class="col-md-4">
                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="fas fa-check-circle"></i></span>
                        <input type="text" class="form-control" placeholder=" معاش " required>
                    </div>

                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="fas fa-venus-mars"></i></span>
                        <select class="form-control">
                            <option value="مرد">مرد</option>
                            <option value="زن">زن</option>
                        </select>
                    </div>

                    <div class="input-group mb-3">
                        <span class="input-group-text"><i class="fas fa-check-circle"></i></span>
                        <input type="text" class="form-control" placeholder=" صنف " required>
                    </div>
                </div>
            </div>

            <!-- بارگذاری عکس -->
            <div class="image-upload  mt-3">
                <label for="file-upload">بارگذاری عکس</label>
                <input type="file" id="file-upload" accept="image/*" />
                <div id="image-preview"></div>
            </div>

            <div class="footer">
                <button type="submit" class="btn btn-light">ثبت‌نام</button>
            </div>
        </form>
    </div>

    <script>
        // پیش نمایش تصویر بارگذاری شده
        const fileInput = document.getElementById("file-upload");
        const imagePreview = document.getElementById("image-preview");

        fileInput.addEventListener("change", function() {
            const file = fileInput.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = document.createElement("img");
                    img.src = e.target.result;
                    imagePreview.innerHTML = ""; // حذف هر تصویری که قبلاً نمایش داده شده
                    imagePreview.appendChild(img);
                };
                reader.readAsDataURL(file);
            }
        });
    </script>

</body>
</html>
