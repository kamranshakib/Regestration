<%- include('menu.ejs') %>

    <style>
        body {
            background-color: #f1f1f1;
            /* font-family: 'Tahoma', sans-serif; */
            direction: rtl;
            text-align: right;
            font-family: 'dana';
        }
        .container {
            max-width: 400px;
            margin-top: 0px;
            padding: 20px;
        }
        .card {
            border-radius: 15px;
            box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.1);
            background-color: #ffffff;
            padding: 20px;
            display: flex;
            /* align-items: center; */
        }
        .profile-pic {
            width: 120px;
            height: 120px;
            border-radius: 10px;
            border: 3px solid #027300;
            object-fit: cover;
            margin-right: 90px; /* فاصله بین عکس و متن */
            margin-left: 0;
        }
        .info-container {
            flex: 1;
            margin-top: 10px;
        }
        .info {
            width: 300px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(0, 0, 0, 0.192);
            justify-content: space-between;
            /* margin-bottom: 10px; */
            font-size: 16px;
            margin-bottom: 15px;
            padding: 0px 10px;
            
        }
        .info strong {
            color: #008423;
            min-width: 120px;
        }
        .info span {
            color: #333;
            /* font-weight: bold; */
        }
    </style>
</head>
<body>

   <% result1.forEach(element => { %>
    <div class="container" style="position: relative;">
        <!-- کارت اطلاعات شاگرد -->
        <div class="card">
            <img src="<%= element.photo_teacher  %>" alt="تصویر شاگرد" class="profile-pic">
            <div class="info-container">
                
                <div class="info">
                    <strong>نام:</strong>
                    <span><%= element.name_teacher  %></span>
                </div>
                <div class="info">
                    <strong>نام خانوادگی:</strong>
                    <span><%= element.LastName_teacher  %></span>
                </div>
                <div class="info">
                    <strong>شماره تماس:</strong>
                    <span><%= element.number_teacher  %></span>
                </div>
               
                <div class="info">
                    <strong>رشته تحصیلی:</strong>
                    <span> <%= element.subject_teacher  %></span>
                </div>
               
                <div class="info">
                    <strong>معاش:</strong>
                    <span><%= element.subject_salary_teacher  %></span>
                </div>
                
                <div class="info">
                    <strong>معاش:</strong>
                    <span><%= element.salary_fisad %></span>
                    <span><%= element.salary_month %></span>
                    <span><%= element.salary_hour %></span>
                </div>
                
                
            </div>
        </div>
        <a href="/showTeacher"><button style="position: absolute; top: -10px ; right: 25px; font-size: 30px; color: red; border: none; background: transparent;">&Cross;</button></a>
    </div>
    <% }); %>

</body>
</html>
