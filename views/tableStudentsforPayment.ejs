<%- include('menu.ejs') %>
<style>
     .container {
            max-width: 900px;
            background: #ffffff5a;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
            position: relative;
            backdrop-filter: blur(5px);
            
        }
        .listTop{
            display: flex;
            gap: 50px;
            border-bottom: 2px solid black;
            margin-bottom: 20px;
            padding-top: 20px;
            padding-bottom: 10px;
        }
        .select{
            border: none;
            font-weight: bold;
            outline: none;
        }
        .searchName input{
            border: none;
            border-bottom: 2px dotted black;
            outline: none;
        }
        .submit input{
            background-color: rgb(0, 145, 19);
            border: none;
            padding: 5px 15px;
            border-radius: 5px;
            color: white;
        }
       
</style>

<div class="container">
    
        <form class="listTop" action="/searchStudents" method="post">
            <div class="classes">
                صنف شاگرد:
                <select name="classesSearch" class="select" >
                    <option class="select" value="">انتخاب صنف</option>     
                    <% result.forEach(element => {  %>
                        <option value="<%= element.nameOfClass %>"><%= element.nameOfClass %></option>
                    <% }); %>
                </select>
            </div>
            <div class="teachers">
                استاد شاگرد:
                <select name="teacherSearchStudents"  class="select">
                    <option value="" class="select"> انتخاب استاد</option>
                   <% result.forEach(element => { %>
                    <option value="<%= element.teacherNameOfClass %>"><%= element.teacherNameOfClass %></option>
                    <% }); %>
                </select>
            </div>
            <div class="searchName">
                نام شاگرد:
               <input type="text" name="nameSearch">
            </div>
            <div class="submit">
                <input type="submit" value="جستجو ">
            </div>
            
        </div>

        </form>
       
    <br><br>
   
    
    

</div>

<%- include('tableOFStudents.ejs') %>

